<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff5f5" />
      <stop offset="50%" stop-color="#ffe4e6" />
      <stop offset="100%" stop-color="#fef2f2" />
    </linearGradient>
    <radialGradient id="fairyGlow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#fffbeb" stop-opacity="0.9" />
      <stop offset="60%" stop-color="#fef3c7" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#fda4af" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="1000" fill="url(#bgGrad1)" />
  <circle cx="400" cy="380" r="320" fill="url(#fairyGlow)" />

  <!-- Bokeh Fairy Lights -->
  <circle cx="150" cy="180" r="18" fill="#fef08a" opacity="0.4" />
  <circle cx="680" cy="220" r="24" fill="#fef08a" opacity="0.35" />
  <circle cx="220" cy="320" r="14" fill="#fef08a" opacity="0.4" />
  <circle cx="600" cy="360" r="16" fill="#fef08a" opacity="0.4" />
  <circle cx="120" cy="460" r="22" fill="#fed7aa" opacity="0.3" />

  <!-- Floral Garland Arch -->
  <path d="M 120 180 Q 400 80 680 180" stroke="#f43f5e" stroke-width="3" fill="none" opacity="0.4" stroke-dasharray="6,8" />
  <circle cx="400" cy="130" r="28" fill="#fda4af" opacity="0.7"/>
  <circle cx="360" cy="140" r="22" fill="#f43f5e" opacity="0.6"/>
  <circle cx="440" cy="140" r="22" fill="#fb7185" opacity="0.6"/>
  <circle cx="310" cy="160" r="18" fill="#fecdd3"/>
  <circle cx="490" cy="160" r="18" fill="#fecdd3"/>

  <!-- Character Container Frame -->
  <g transform="translate(400, 480)" filter="url(#shadow)">
    <!-- Aura / Halo -->
    <circle cx="0" cy="-60" r="220" fill="#ffffff" opacity="0.8" />
    <circle cx="0" cy="-60" r="200" stroke="#fbcfe8" stroke-width="4" stroke-dasharray="10,12" fill="none" opacity="0.6" />

    <!-- Baby Princess Illustration -->
    <!-- Vintage Lace Gown skirt -->
    <path d="M -130 180 C -120 40, -50 0, 0 0 C 50 0, 120 40, 130 180 C 70 210, -70 210, -130 180 Z" fill="#ffffff" stroke="#fce7f3" stroke-width="3"/>
    <path d="M -110 180 C -80 70, -30 20, 0 20 C 30 20, 80 70, 110 180" fill="none" stroke="#fbcfe8" stroke-width="2" stroke-dasharray="4,6"/>
    <!-- Bodice & Lace Collar -->
    <path d="M -50 10 Q 0 20 50 10 L 45 -40 Q 0 -35 -45 -40 Z" fill="#fff1f2" stroke="#fda4af" stroke-width="2"/>
    <path d="M -55 -40 Q -30 -15 0 -35 Q 30 -15 55 -40" fill="none" stroke="#f43f5e" stroke-width="3"/>

    <!-- Arms -->
    <ellipse cx="-55" cy="5" rx="16" ry="32" transform="rotate(25, -55, 5)" fill="#fed7aa"/>
    <ellipse cx="55" cy="5" rx="16" ry="32" transform="rotate(-25, 55, 5)" fill="#fed7aa"/>

    <!-- Head & Neck -->
    <rect x="-18" y="-55" width="36" height="24" rx="12" fill="#fed7aa"/>
    <ellipse cx="0" cy="-110" rx="72" ry="76" fill="#fed7aa"/>
    <!-- Rosy Cheeks -->
    <ellipse cx="-42" cy="-96" rx="16" ry="10" fill="#f43f5e" opacity="0.35"/>
    <ellipse cx="42" cy="-96" rx="16" ry="10" fill="#f43f5e" opacity="0.35"/>
    <!-- Happy Innocent Eyes -->
    <ellipse cx="-26" cy="-115" rx="7" ry="10" fill="#1e293b"/>
    <circle cx="-24" cy="-118" r="3" fill="#ffffff"/>
    <ellipse cx="26" cy="-115" rx="7" ry="10" fill="#1e293b"/>
    <circle cx="28" cy="-118" r="3" fill="#ffffff"/>
    <!-- Cute Smile -->
    <path d="M -14 -85 Q 0 -72 14 -85" stroke="#e11d48" stroke-width="3" stroke-linecap="round" fill="#ffe4e6"/>

    <!-- Cute Double Pigtails (Two high ponytails like baby's photo!) -->
    <!-- Left Pigtail -->
    <path d="M -60 -155 C -105 -190, -115 -145, -70 -130 Z" fill="#1e293b"/>
    <circle cx="-62" cy="-145" r="8" fill="#f43f5e"/>
    <!-- Right Pigtail -->
    <path d="M 60 -155 C 105 -190, 115 -145, 70 -130 Z" fill="#1e293b"/>
    <circle cx="62" cy="-145" r="8" fill="#f43f5e"/>

    <!-- Bangs Hair -->
    <path d="M -72 -120 C -70 -175, 70 -175, 72 -120 C 60 -140, 20 -150, 0 -138 C -20 -150, -60 -140, -72 -120 Z" fill="#1e293b"/>
    <path d="M -40 -138 Q -20 -126 0 -136 Q 20 -126 40 -138" stroke="#1e293b" stroke-width="8" stroke-linecap="round" fill="none"/>

    <!-- Floral Headband Crown -->
    <path d="M -56 -146 Q 0 -162 56 -146" stroke="#fbbf24" stroke-width="3" fill="none"/>
    <circle cx="-40" cy="-150" r="7" fill="#ffffff" stroke="#f43f5e" stroke-width="1.5"/>
    <circle cx="-20" cy="-155" r="9" fill="#fda4af" stroke="#ffffff" stroke-width="1.5"/>
    <circle cx="0" cy="-158" r="11" fill="#f43f5e" stroke="#ffffff" stroke-width="2"/>
    <circle cx="20" cy="-155" r="9" fill="#fda4af" stroke="#ffffff" stroke-width="1.5"/>
    <circle cx="40" cy="-150" r="7" fill="#ffffff" stroke="#f43f5e" stroke-width="1.5"/>
  </g>

  <!-- Title Badge in Image -->
  <g transform="translate(400, 860)">
    <rect x="-190" y="-35" width="380" height="70" rx="35" fill="#ffffff" opacity="0.95" filter="url(#shadow)"/>
    <text x="0" y="5" font-family="'Playfair Display', serif" font-size="24" font-weight="bold" fill="#be123c" text-anchor="middle">Bé Công Chúa Nhỏ</text>
    <text x="0" y="25" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="500" fill="#9f1239" text-anchor="middle">Thiên Thần Tròn 1 Tuổi</text>
  </g>
</svg>
