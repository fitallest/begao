<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="summerBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="60%" stop-color="#bae6fd" />
      <stop offset="100%" stop-color="#7dd3fc" />
    </linearGradient>
    <radialGradient id="poolWater" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="70%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#0369a1" />
    </radialGradient>
    <filter id="poolShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0284c7" flood-opacity="0.25"/>
    </filter>
  </defs>

  <rect width="800" height="1000" fill="url(#summerBg)" />

  <!-- Sunny ambiance & garden blur -->
  <circle cx="680" cy="140" r="100" fill="#fef08a" opacity="0.4" />
  <circle cx="100" cy="180" r="80" fill="#bbf7d0" opacity="0.3" />
  <circle cx="720" cy="340" r="60" fill="#bbf7d0" opacity="0.3" />

  <!-- Inflatable pool ring -->
  <ellipse cx="400" cy="650" rx="340" ry="220" fill="url(#poolWater)" filter="url(#poolShadow)"/>
  <ellipse cx="400" cy="650" rx="340" ry="220" fill="none" stroke="#38bdf8" stroke-width="28" opacity="0.8"/>
  <ellipse cx="400" cy="650" rx="320" ry="200" fill="none" stroke="#bae6fd" stroke-width="6" stroke-dasharray="16,16"/>

  <!-- Water Ripples -->
  <ellipse cx="360" cy="620" rx="160" ry="70" fill="none" stroke="#ffffff" stroke-width="4" opacity="0.5"/>
  <ellipse cx="450" cy="670" rx="200" ry="80" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.4"/>

  <!-- Baby in Pool -->
  <g transform="translate(400, 480)">
    <!-- Body in Floral Swimsuit -->
    <path d="M -60 120 C -50 40, -40 20, 0 20 C 40 20, 50 40, 60 120 Z" fill="#ffe4e6"/>
    <!-- Swimsuit straps & floral pattern -->
    <path d="M -45 20 Q 0 35 45 20 L 40 100 Q 0 115 -40 100 Z" fill="#f43f5e"/>
    <circle cx="-15" cy="50" r="5" fill="#fef08a"/>
    <circle cx="15" cy="60" r="6" fill="#fbcfe8"/>
    <circle cx="0" cy="85" r="5" fill="#fef08a"/>

    <!-- Arms splashing -->
    <ellipse cx="-60" cy="35" rx="18" ry="34" transform="rotate(35, -60, 35)" fill="#fed7aa"/>
    <ellipse cx="60" cy="35" rx="18" ry="34" transform="rotate(-35, 60, 35)" fill="#fed7aa"/>

    <!-- Pink Water Scoop held in hand -->
    <g transform="translate(-75, 45)">
      <path d="M -15 0 C -15 25, 25 25, 25 0 Z" fill="#fb7185"/>
      <rect x="20" y="-8" width="30" height="10" rx="4" transform="rotate(-20, 20, -8)" fill="#f43f5e"/>
      <!-- Water pouring from scoop -->
      <path d="M -10 18 Q 0 70 30 110" stroke="#bae6fd" stroke-width="8" stroke-linecap="round" fill="none" opacity="0.8"/>
      <circle cx="15" cy="65" r="4" fill="#e0f2fe"/>
      <circle cx="28" cy="85" r="5" fill="#e0f2fe"/>
      <circle cx="35" cy="115" r="6" fill="#e0f2fe"/>
    </g>

    <!-- Head & Cheeks -->
    <ellipse cx="0" cy="-60" rx="72" ry="76" fill="#fed7aa"/>
    <ellipse cx="-40" cy="-45" rx="16" ry="10" fill="#f43f5e" opacity="0.4"/>
    <ellipse cx="40" cy="-45" rx="16" ry="10" fill="#f43f5e" opacity="0.4"/>

    <!-- Laughing Eyes -->
    <path d="M -35 -65 Q -25 -78 -15 -65" stroke="#1e293b" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <path d="M 15 -65 Q 25 -78 35 -65" stroke="#1e293b" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <!-- Big joyful smile -->
    <path d="M -20 -35 Q 0 -15 20 -35" stroke="#e11d48" stroke-width="3.5" fill="#ffe4e6" stroke-linecap="round"/>

    <!-- Double Pigtails -->
    <path d="M -60 -105 C -105 -140, -115 -95, -70 -80 Z" fill="#1e293b"/>
    <circle cx="-62" cy="-95" r="8" fill="#38bdf8"/>
    <path d="M 60 -105 C 105 -140, 115 -95, 70 -80 Z" fill="#1e293b"/>
    <circle cx="62" cy="-95" r="8" fill="#38bdf8"/>

    <!-- Bangs -->
    <path d="M -72 -70 C -70 -125, 70 -125, 72 -70 C 60 -90, 20 -100, 0 -88 C -20 -100, -60 -90, -72 -70 Z" fill="#1e293b"/>
  </g>

  <!-- Yellow Rubber Ducks Floating -->
  <g transform="translate(200, 680)">
    <ellipse cx="0" cy="15" rx="26" ry="18" fill="#facc15"/>
    <circle cx="16" cy="-2" r="14" fill="#facc15"/>
    <!-- Beak -->
    <polygon points="28,-6 40,-2 28,2" fill="#f97316"/>
    <circle cx="22" cy="-6" r="2.5" fill="#0f172a"/>
  </g>

  <g transform="translate(600, 650) scale(0.85)">
    <ellipse cx="0" cy="15" rx="26" ry="18" fill="#facc15"/>
    <circle cx="-16" cy="-2" r="14" fill="#facc15"/>
    <polygon points="-28,-6 -40,-2 -28,2" fill="#f97316"/>
    <circle cx="-22" cy="-6" r="2.5" fill="#0f172a"/>
  </g>

  <!-- Colorful water balls -->
  <circle cx="290" cy="740" r="24" fill="#ec4899" opacity="0.9"/>
  <circle cx="510" cy="760" r="28" fill="#3b82f6" opacity="0.9"/>
  <circle cx="410" cy="790" r="22" fill="#eab308" opacity="0.9"/>

  <!-- Badge in Image -->
  <g transform="translate(400, 910)">
    <rect x="-190" y="-35" width="380" height="70" rx="35" fill="#ffffff" opacity="0.95" filter="url(#poolShadow)"/>
    <text x="0" y="5" font-family="'Playfair Display', serif" font-size="24" font-weight="bold" fill="#0284c7" text-anchor="middle">Mùa Hè Tung Tăng</text>
    <text x="0" y="25" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="500" fill="#0369a1" text-anchor="middle">Nụ Cười Hồn Nhiên Của Bé</text>
  </g>
</svg>
