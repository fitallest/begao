<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fdf4ff" />
      <stop offset="50%" stop-color="#fae8ff" />
      <stop offset="100%" stop-color="#fef3c7" />
    </linearGradient>
    <radialGradient id="sunGlow" cx="50%" cy="30%" r="50%">
      <stop offset="0%" stop-color="#fef08a" stop-opacity="0.9" />
      <stop offset="60%" stop-color="#ffffff" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="800" height="1000" fill="url(#bgGrad5)" />
  <circle cx="400" cy="350" r="300" fill="url(#sunGlow)" />

  <!-- Balloons -->
  <g transform="translate(180, 200)">
    <ellipse cx="0" cy="0" rx="40" ry="50" fill="#f43f5e" opacity="0.8"/>
    <path d="M0 50 Q10 120 20 180" stroke="#f43f5e" stroke-width="2" fill="none"/>
  </g>
  <g transform="translate(620, 220)">
    <ellipse cx="0" cy="0" rx="45" ry="55" fill="#a855f7" opacity="0.75"/>
    <path d="M0 55 Q-15 130 -10 180" stroke="#a855f7" stroke-width="2" fill="none"/>
  </g>
  <g transform="translate(680, 160)">
    <ellipse cx="0" cy="0" rx="35" ry="45" fill="#f59e0b" opacity="0.8"/>
    <path d="M0 45 Q-5 130 -40 220" stroke="#f59e0b" stroke-width="2" fill="none"/>
  </g>

  <!-- Baby girl taking first steps -->
  <g transform="translate(400, 490)">
    <!-- Cute pastel dress -->
    <path d="M -70 140 C -60 40, -40 20, 0 20 C 40 20, 60 40, 70 140 Z" fill="#d946ef" opacity="0.85"/>
    <ellipse cx="0" cy="140" rx="70" ry="25" fill="#c026d3"/>
    <!-- Yellow flower on dress -->
    <circle cx="0" cy="65" r="10" fill="#facc15"/>

    <!-- Tiny baby legs and pink shoes -->
    <ellipse cx="-25" cy="165" rx="14" ry="20" fill="#fed7aa"/>
    <ellipse cx="-25" cy="180" rx="18" ry="12" fill="#ec4899"/>
    <ellipse cx="28" cy="160" rx="14" ry="20" fill="#fed7aa"/>
    <ellipse cx="28" cy="175" rx="18" ry="12" fill="#ec4899"/>

    <!-- Joyful outstretched arms -->
    <ellipse cx="-60" cy="35" rx="16" ry="34" transform="rotate(-35, -60, 35)" fill="#fed7aa"/>
    <ellipse cx="60" cy="35" rx="16" ry="34" transform="rotate(35, 60, 35)" fill="#fed7aa"/>

    <!-- Head & Cheeks -->
    <ellipse cx="0" cy="-60" rx="72" ry="76" fill="#fed7aa"/>
    <ellipse cx="-42" cy="-45" rx="16" ry="10" fill="#ec4899" opacity="0.4"/>
    <ellipse cx="42" cy="-45" rx="16" ry="10" fill="#ec4899" opacity="0.4"/>

    <!-- Big Laughing Eyes -->
    <path d="M -35 -65 Q -25 -78 -15 -65" stroke="#1e293b" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <path d="M 15 -65 Q 25 -78 35 -65" stroke="#1e293b" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <!-- Open joyous laugh -->
    <path d="M -22 -35 Q 0 -10 22 -35 Z" fill="#e11d48"/>

    <!-- Double Pigtails -->
    <path d="M -60 -105 C -105 -140, -115 -95, -70 -80 Z" fill="#1e293b"/>
    <circle cx="-62" cy="-95" r="8" fill="#ec4899"/>
    <path d="M 60 -105 C 105 -140, 115 -95, 70 -80 Z" fill="#1e293b"/>
    <circle cx="62" cy="-95" r="8" fill="#ec4899"/>
    <!-- Hair bangs -->
    <path d="M -72 -70 C -70 -125, 70 -125, 72 -70 C 60 -90, 20 -100, 0 -88 C -20 -100, -60 -90, -72 -70 Z" fill="#1e293b"/>
  </g>

  <!-- Title Badge in Image -->
  <g transform="translate(400, 910)">
    <rect x="-190" y="-35" width="380" height="70" rx="35" fill="#ffffff" opacity="0.95"/>
    <text x="0" y="5" font-family="'Playfair Display', serif" font-size="24" font-weight="bold" fill="#a21caf" text-anchor="middle">Bước Chân Đầu Đời</text>
    <text x="0" y="25" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="500" fill="#86198f" text-anchor="middle">365 Ngày Lớn Khôn</text>
  </g>
</svg>
