<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff1f2" />
      <stop offset="50%" stop-color="#fdf2f8" />
      <stop offset="100%" stop-color="#fef3c7" />
    </linearGradient>
    <radialGradient id="cakeGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fef08a" stop-opacity="0.8" />
      <stop offset="70%" stop-color="#ffffff" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="800" height="1000" fill="url(#bgGrad4)" />
  <circle cx="400" cy="400" r="320" fill="url(#cakeGlow)" />

  <!-- Confetti and stars -->
  <circle cx="150" cy="180" r="10" fill="#f43f5e" opacity="0.6"/>
  <circle cx="650" cy="220" r="12" fill="#fbbf24" opacity="0.7"/>
  <circle cx="200" cy="300" r="8" fill="#38bdf8" opacity="0.5"/>
  <circle cx="620" cy="360" r="10" fill="#a855f7" opacity="0.5"/>

  <!-- Baby with Birthday Cake -->
  <g transform="translate(400, 480)">
    <!-- Birthday Cake on table -->
    <g transform="translate(0, 160)">
      <ellipse cx="0" cy="80" rx="180" ry="40" fill="#fed7aa" opacity="0.6"/>
      <!-- Cake tier 1 -->
      <path d="M-120 40 L-120 90 Q 0 115 120 90 L120 40 Z" fill="#ffe4e6"/>
      <ellipse cx="0" cy="40" rx="120" ry="30" fill="#ffffff"/>
      <!-- Cream drips -->
      <path d="M-120 40 Q-90 65 -60 40 Q-30 65 0 40 Q30 65 60 40 Q90 65 120 40" stroke="#f43f5e" stroke-width="6" fill="none"/>
      <!-- Strawberry topping -->
      <circle cx="-50" cy="25" r="12" fill="#e11d48"/>
      <circle cx="0" cy="20" r="14" fill="#e11d48"/>
      <circle cx="50" cy="25" r="12" fill="#e11d48"/>
      <!-- Candle 1 -->
      <rect x="-8" y="-30" width="16" height="50" rx="4" fill="#fbbf24"/>
      <!-- Flame -->
      <ellipse cx="0" cy="-45" rx="10" ry="16" fill="#f97316"/>
      <ellipse cx="0" cy="-43" rx="5" ry="10" fill="#fef08a"/>
    </g>

    <!-- Baby Figure Behind Cake -->
    <!-- Bodice -->
    <path d="M -50 70 Q 0 85 50 70 L 45 130 Q 0 145 -45 130 Z" fill="#fff1f2" stroke="#fda4af" stroke-width="2"/>
    <!-- Head & Cheeks -->
    <ellipse cx="0" cy="0" rx="72" ry="76" fill="#fed7aa"/>
    <ellipse cx="-42" cy="15" rx="16" ry="10" fill="#f43f5e" opacity="0.35"/>
    <ellipse cx="42" cy="15" rx="16" ry="10" fill="#f43f5e" opacity="0.35"/>
    <!-- Happy Innocent Eyes -->
    <ellipse cx="-26" cy="-5" rx="7" ry="10" fill="#1e293b"/>
    <circle cx="-24" cy="-8" r="3" fill="#ffffff"/>
    <ellipse cx="26" cy="-5" rx="7" ry="10" fill="#1e293b"/>
    <circle cx="28" cy="-8" r="3" fill="#ffffff"/>
    <!-- Cute smile -->
    <path d="M -16 25 Q 0 42 16 25" stroke="#e11d48" stroke-width="3" stroke-linecap="round" fill="#ffe4e6"/>

    <!-- Double Pigtails -->
    <path d="M -60 -45 C -105 -80, -115 -35, -70 -20 Z" fill="#1e293b"/>
    <circle cx="-62" cy="-35" r="8" fill="#fbbf24"/>
    <path d="M 60 -45 C 105 -80, 115 -35, 70 -20 Z" fill="#1e293b"/>
    <circle cx="62" cy="-35" r="8" fill="#fbbf24"/>
    <!-- Hair bangs -->
    <path d="M -72 -10 C -70 -65, 70 -65, 72 -10 C 60 -30, 20 -40, 0 -28 C -20 -40, -60 -30, -72 -10 Z" fill="#1e293b"/>
    <!-- Party cone hat -->
    <polygon points="0,-120 -35,-40 35,-40" fill="#ec4899"/>
    <circle cx="0" cy="-125" r="10" fill="#fbbf24"/>
    <circle cx="-10" cy="-70" r="5" fill="#ffffff"/>
    <circle cx="10" cy="-60" r="6" fill="#fef08a"/>
  </g>

  <!-- Title Badge in Image -->
  <g transform="translate(400, 890)">
    <rect x="-190" y="-35" width="380" height="70" rx="35" fill="#ffffff" opacity="0.95"/>
    <text x="0" y="5" font-family="'Playfair Display', serif" font-size="24" font-weight="bold" fill="#be123c" text-anchor="middle">Chiếc Bánh Đầu Đời</text>
    <text x="0" y="25" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="500" fill="#9f1239" text-anchor="middle">Ước Nguyện Tuổi Mới</text>
  </g>
</svg>
